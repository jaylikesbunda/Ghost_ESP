# Elecrow CrowPanel Advanced P4 7/9/10.1-inch MIPI HMI v1.1 profile.
# This is intentionally a defaults fragment; ESP-IDF fills in target defaults.
CONFIG_IDF_TARGET="esp32p4"
CONFIG_BUILD_CONFIG_TEMPLATE="CrowPanel P4 7/9/10in v1.1"
CONFIG_ESP32P4_SELECTS_REV_LESS_V3=y
CONFIG_ESP32P4_REV_MIN_1=y

CONFIG_WITH_SCREEN=y
CONFIG_TFT_WIDTH=1024
CONFIG_TFT_HEIGHT=600
CONFIG_USE_TOUCHSCREEN=y
CONFIG_CROWPANEL_ADVANCED_P4=y
# CONFIG_CROWPANEL_P4_REV_V12_PLUS is not set
CONFIG_CROWPANEL_P4_PANEL_MIPI_1024X600=y
CONFIG_CROWPANEL_P4_CAMERA=y
# Leave VFS registration headroom for CSI/ISP, SD and the other services.
# IDF 6.0.2 refuses re-registration once the table high-water mark reaches
# its limit, even after camera devices have been unregistered.
CONFIG_VFS_MAX_COUNT=16

# Elecrow factory camera: SC2336 over two-lane MIPI CSI.
CONFIG_CAMERA_SC2336=y
CONFIG_CAMERA_SC2336_AUTO_DETECT_MIPI_INTERFACE_SENSOR=y
CONFIG_CAMERA_SC2336_MIPI_RAW8_1024X600_30FPS=y
CONFIG_CAMERA_SC2336_MIPI_DEFAULT_FMT_RAW8_1024X600_30FPS=y
CONFIG_ESP_VIDEO_ENABLE_ISP=y
CONFIG_ESP_VIDEO_ENABLE_MIPI_CSI_VIDEO_DEVICE=y
# Keep a CSI fallback buffer so a delayed consumer drops frames instead of asserting.
# CONFIG_ESP_VIDEO_DISABLE_MIPI_CSI_DRIVER_BACKUP_BUFFER is not set
CONFIG_ESP_VIDEO_ENABLE_ISP_VIDEO_DEVICE=y
CONFIG_ESP_VIDEO_ENABLE_ISP_PIPELINE_CONTROLLER=y

CONFIG_LV_COLOR_DEPTH_16=y
# CONFIG_LV_COLOR_16_SWAP is not set
CONFIG_LV_FONT_MONTSERRAT_8=y
CONFIG_LV_FONT_MONTSERRAT_10=y
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_18=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_TOUCH_CONTROLLER_GT911=y
# CONFIG_LV_GT911_SWAPXY is not set
# CONFIG_LV_GT911_INVERT_X is not set
# CONFIG_LV_GT911_INVERT_Y is not set
CONFIG_USING_MMC_1_BIT=y
CONFIG_SD_MMC_CLK=43
CONFIG_SD_MMC_CMD=44
CONFIG_SD_MMC_D0=39
CONFIG_LV_I2C_TOUCH=y
CONFIG_LV_I2C_TOUCH_PORT_0=y
CONFIG_LV_I2C_TOUCH_PORT=0
CONFIG_I2C_MANAGER_0_ENABLED=y
CONFIG_I2C_MANAGER_0_SDA=45
CONFIG_I2C_MANAGER_0_SCL=46
CONFIG_I2C_MANAGER_0_FREQ_HZ=400000
CONFIG_I2C_MANAGER_0_TIMEOUT=100
CONFIG_I2C_MANAGER_0_LOCK_TIMEOUT=50
CONFIG_I2C_MANAGER_0_PULLUPS=y

CONFIG_SPIRAM=y
CONFIG_FREERTOS_HZ=1000
CONFIG_LV_DISP_DEF_REFR_PERIOD=16
# Prefer internal DMA RAM for the hosted Wi-Fi mempool where it fits. The
# allocator falls back to DMA-capable PSRAM on P4 when internal RAM is full.
# CONFIG_ESP_HOSTED_MEMPOOL_PREFER_SPIRAM is not set

# P4 TLS: accept valid cross-signed chains used by the Cloud Store/CDN.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_CROSS_SIGNED_VERIFY=y
# The P4 revision used by this panel does not expose the ECDSA peripheral;
# use the mbedTLS software verifier instead of emitting unsupported-chip logs.
# CONFIG_MBEDTLS_HARDWARE_ECDSA_VERIFY is not set

CONFIG_LV_DISP_BACKLIGHT_PWM=y
CONFIG_LV_BACKLIGHT_ACTIVE_LVL=y
CONFIG_LV_DISP_PIN_BCKL=31
CONFIG_HAS_CROWPANEL_NS4168=y
CONFIG_HAS_AUDIO_PLAYER=y

# Elecrow CrowPanel Advanced P4 7/9/10.1-inch wireless Meshtastic module (SX1262).
# The socket wires the radio to SPI3 (SCK8/MISO7/MOSI6, NSS10, BUSY9); v1.1
# boards keep the IRQ/RST nets on GPIO53/54. The onboard C6 keeps SDIO
# (GPIO14-19) and the microSD keeps SDMMC (GPIO39/43/44), so both stay
# available; GPIO53/54 are shared with the UART passthrough and nRF24 and must
# not be enabled in the same build.
CONFIG_HAS_LORA=y
CONFIG_LORA_SPI_HOST=3
CONFIG_LORA_SPI_MOSI_PIN=6
CONFIG_LORA_SPI_MISO_PIN=7
CONFIG_LORA_SPI_SCK_PIN=8
CONFIG_LORA_NSS_PIN=10
CONFIG_LORA_DIO1_PIN=53
CONFIG_LORA_BUSY_PIN=9
CONFIG_LORA_RST_PIN=54
CONFIG_LORA_VEXT_PIN=-1
CONFIG_LORA_VEXT_ACTIVE_LOW=y
CONFIG_LORA_ENABLE_PIN=-1
CONFIG_LORA_MODULE_SX1262=y
# CONFIG_LORA_MODULE_SX1276 is not set
# CONFIG_LORA_MODULE_LLCC68 is not set
# CONFIG_LORA_TCXO_DISABLED is not set
# CONFIG_LORA_TCXO_1V8 is not set
CONFIG_LORA_TCXO_3V3=y
CONFIG_LORA_MAX_TX_DBM=22
CONFIG_LORA_MSG_RING=32
# CONFIG_LORA_REGION_US915 is not set
# CONFIG_LORA_REGION_EU868 is not set
# CONFIG_LORA_REGION_EU433 is not set
# CONFIG_LORA_REGION_CN is not set
# CONFIG_LORA_REGION_JP is not set
CONFIG_LORA_REGION_ANZ=y
# CONFIG_LORA_REGION_KR is not set
# CONFIG_LORA_REGION_TW is not set
# CONFIG_LORA_REGION_RU is not set
# CONFIG_LORA_REGION_IN is not set
# CONFIG_LORA_REGION_NZ865 is not set
# CONFIG_LORA_REGION_TH is not set
# CONFIG_LORA_REGION_UA433 is not set
# CONFIG_LORA_REGION_MY433 is not set
# CONFIG_LORA_REGION_MY919 is not set
# CONFIG_LORA_REGION_SG923 is not set
# CONFIG_LORA_REGION_PH433 is not set
# CONFIG_LORA_REGION_PH868 is not set
# CONFIG_LORA_REGION_PH915 is not set
# CONFIG_LORA_REGION_ANZ433 is not set
# CONFIG_LORA_REGION_KZ433 is not set
# CONFIG_LORA_REGION_KZ863 is not set
# CONFIG_LORA_REGION_NP865 is not set
# CONFIG_LORA_REGION_BR902 is not set
# end of LoRa Options

CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
# CONFIG_BT_BLUEDROID_ENABLED is not set
# CONFIG_BT_NIMBLE_TRANSPORT_UART is not set
CONFIG_ESP_HOSTED_ENABLE_BT_NIMBLE=y
CONFIG_HAS_BADBLE=y
# CONFIG_NFC_CHAMELEON is not set

# ESP-Hosted SDIO wiring used by 7/9/10.1-inch v1.1 boards.
CONFIG_ESP_HOSTED_ENABLED=y
CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_P4_DEV_BOARD_NONE=y
CONFIG_ESP_HOSTED_PRIV_SDIO_OPTION=y
CONFIG_ESP_HOSTED_PRIV_SPI_HD_OPTION=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_IDF_SLAVE_TARGET="esp32c6"
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y
CONFIG_ESP_HOSTED_SDIO_OPTIMIZATION_RX_STREAMING_MODE=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_SDIO_SLOT=1
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
CONFIG_ESP_HOSTED_SDIO_BUS_WIDTH=4
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=40000
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=32
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CMD_SLOT_1=19
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CLK_SLOT_1=18
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D0_SLOT_1=17
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D1_4BIT_BUS_SLOT_1=16
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D2_4BIT_BUS_SLOT_1=15
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D3_4BIT_BUS_SLOT_1=14
CONFIG_ESP_HOSTED_SDIO_PIN_CMD=19
CONFIG_ESP_HOSTED_SDIO_PIN_CLK=18
CONFIG_ESP_HOSTED_SDIO_PIN_D0=17
CONFIG_ESP_HOSTED_SDIO_PIN_D1=16
CONFIG_ESP_HOSTED_SDIO_PIN_D2=15
CONFIG_ESP_HOSTED_SDIO_PIN_D3=14
CONFIG_ESP_HOSTED_GPIO_SLAVE_RESET_SLAVE=32

CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions_crowpanel_p4.csv"
