menu "Ghost ESP Options"

    menu "Device Details"

    config BUILD_CONFIG_TEMPLATE
        string "Specify template used to build"
        default "unknown_board"
        help
            Specify GESP build config template that was used at build time.
    endmenu
    
    menu "LED Options"
    
    config USE_NEOPIXEL
        bool "Use Neopixel RGB LEDs"
        default n
        help
            Enable Neopixel RGB LED support. When enabled, a single data pin will be used for RGB control.
    
    config LED_DATA_PIN
        int "LED Data Pin"
        default 0
        depends on USE_NEOPIXEL
        help
            Set the data pin for Neopixel LEDs.
    
    config NUM_LEDS
        int "Number of LEDs"
        default 0
        help
            Set the number of LEDs connected.
    
    config RED_RGB_PIN
        int "Red RGB Pin"
        default 0
        depends on !USE_NEOPIXEL
        help
            Define the pin for the red color of RGB LED when not using Neopixel.
    
    config GREEN_RGB_PIN
        int "Green RGB Pin"
        default 0
        depends on !USE_NEOPIXEL
        help
            Define the pin for the green color of RGB LED when not using Neopixel.
    
    config BLUE_RGB_PIN
        int "Blue RGB Pin"
        default 0
        depends on !USE_NEOPIXEL
        help
            Define the pin for the blue color of RGB LED when not using Neopixel.

    config ENABLE_MIC_RGB_VISUALIZER
        bool "Enable MIC RGB Visualizer (receive from GhostLink peer)"
        depends on USE_NEOPIXEL
        default n
        help
            Enable the MIC RGB Visualizer mode that receives audio amplitude data
            from a GhostLink peer device with a microphone. The peer must have
            CONFIG_HAS_MIC enabled to transmit audio data.
    
    endmenu
    
    menu "Display Options"
    
    config WITH_SCREEN
        bool "Enable Screen Support"
        default n
        help
            Enable or disable screen support.
    
    config TFT_WIDTH
        int "TFT Width"
        default 240
        depends on WITH_SCREEN
        help
            Set the width of the TFT display.
    
    config TFT_HEIGHT
        int "TFT Height"
        default 320
        depends on WITH_SCREEN
        help
            Set the height of the TFT display.

    config CROWPANEL_1P28_ROTARY
        bool "Elecrow CrowPanel 1.28-inch rotary display"
        default n
        depends on IDF_TARGET_ESP32S3 && WITH_SCREEN
        help
            Enable the Elecrow CrowPanel 1.28-inch HMI with its round
            240x240 GC9A01 SPI display, CST816D touch controller, rotary
            encoder, encoder push switch, and GPIO46 PWM backlight.
            This also selects the round-display-safe main menu and app
            gallery presentation.

    config CROWPANEL_EPAPER_42
        bool "Use Elecrow CrowPanel 4.2-inch e-paper"
        default n
        depends on IDF_TARGET_ESP32S3 && WITH_SCREEN
        help
            Enable the Elecrow CrowPanel 4.2-inch 400x300 SSD1683 e-paper
            display. The panel is driven from the factory firmware's SPI pin
            map and uses five active-low GPIO buttons for navigation.

    config CROWPANEL_EPAPER_579
        bool "Use Elecrow CrowPanel 5.79-inch e-paper"
        default n
        select CROWPANEL_EPAPER_42
        depends on IDF_TARGET_ESP32S3 && WITH_SCREEN
        help
            Enable the Elecrow CrowPanel 5.79-inch 792x272 dual-SSD1683
            e-paper display. This selects the shared CrowPanel e-paper
            support and uses the board's GPIO11/12 and GPIO45-48 EPD pins.

    config USE_TOUCHSCREEN
        bool "Enable Touchscreen"
        default n
        help
            Enable touchscreen input.

    config GHOSTESP_P4_PPA_RENDER
        bool "Use ESP32-P4 PPA for LVGL rendering"
        depends on IDF_TARGET_ESP32P4 && WITH_SCREEN
        default y
        help
            Accelerate eligible RGB565 fills and image blends with the P4 PPA.
            Unsupported operations automatically use LVGL software rendering.

    config USE_7_INCHER
        bool "Use 7-inch Display"
        default n
        help
            Set to enable 7-inch display support.

    config Waveshare_LCD
        bool "Enable Waveshare LCD"
        default n
        help
            Enable support for Waveshare LCD.

    config Crowtech_LCD
        bool "Enable Crowtech LCD"
        default n
        help
            Enable support for Crowtech LCD.

    config CROWPANEL_ADVANCE_7_LCD
        bool "Enable Elecrow CrowPanel Advance 7-inch LCD"
        default n
        depends on USE_7_INCHER
        help
            Enable the Elecrow CrowPanel Advance 7-inch HMI RGB display.
            This board uses a dedicated RGB pin map and GT911 touch on I2C0.

    config CROWPANEL_ADVANCE_5_LCD
        bool "Enable Elecrow CrowPanel Advance 5-inch LCD"
        default n
        depends on USE_7_INCHER
        help
            Enable the 800x480 ST7262 RGB panel and GT911 touch controller.

    config CROWPANEL_ADVANCE_43_LCD
        bool "Enable Elecrow CrowPanel Advance 4.3-inch LCD"
        default n
        depends on USE_7_INCHER
        help
            Enable the 800x480 ST7265 RGB panel and GT911 touch controller.

    config CROWPANEL_ADVANCE_35_LCD
        bool "Enable Elecrow CrowPanel Advance 3.5-inch LCD"
        default n
        help
            Enable the 480x320 ILI9488 SPI panel and GT911 touch controller.

    config CROWPANEL_ADVANCE_28_LCD
        bool "Enable Elecrow CrowPanel Advance 2.8-inch LCD"
        default n
        help
            Enable the 320x240 ST7789 SPI panel and FT6336U/FT5x06 touch controller.

    config CROWPANEL_ADVANCE_24_LCD
        bool "Enable Elecrow CrowPanel Advance 2.4-inch LCD"
        default n
        help
            Enable the 320x240 ST7789 SPI panel and FT6336U/FT5x06 touch controller.

    config CROWPANEL_ADVANCE_RGB_LCD
        bool
        default y if CROWPANEL_ADVANCE_7_LCD || CROWPANEL_ADVANCE_5_LCD || CROWPANEL_ADVANCE_43_LCD

    config CROWPANEL_ADVANCE_SMALL_SPI_LCD
        bool
        default y if CROWPANEL_ADVANCE_28_LCD || CROWPANEL_ADVANCE_24_LCD

    config CROWPANEL_ADVANCE_S3_LCD
        bool
        default y if CROWPANEL_ADVANCE_RGB_LCD || CROWPANEL_ADVANCE_35_LCD || CROWPANEL_ADVANCE_SMALL_SPI_LCD

    config Sunton_LCD
        bool "Enable Sunton LCD"
        default n
        help
            Enable support for Sunton LCD.

    config JC3248W535EN_LCD
        bool "Enable JC3248W535EN LCD"
        default n
        help
            Enable support for JC3248W535EN LCD.

    config CROWPANEL_ADVANCED_P4
        bool "Enable Elecrow CrowPanel Advanced P4 HMI"
        default n
        depends on IDF_TARGET_ESP32P4
        help
            Enable the Elecrow CrowPanel Advanced P4 display family. Select
             the panel transport below for the physical display variant.

    config CROWPANEL_P4_REV_V12_PLUS
        bool "CrowPanel Advanced P4 board revision v1.2 or newer"
        default y
        depends on CROWPANEL_ADVANCED_P4
        help
            Select the v1.2+ board power and ESP-Hosted wiring. Disable this
            only for boards marked v1.1.

    choice CROWPANEL_P4_PANEL
        bool "CrowPanel Advanced P4 panel variant"
        default CROWPANEL_P4_PANEL_MIPI_1024X600
        depends on CROWPANEL_ADVANCED_P4
        help
            Select the display bus and geometry used by the attached panel.

        config CROWPANEL_P4_PANEL_MIPI_1024X600
            bool "7-inch / 9-inch / 10.1-inch (1024x600 MIPI-DSI)"
            help
                Use the EK79007 two-lane MIPI-DSI panel used by the
                CrowPanel Advanced 7-inch, 9-inch, and 10.1-inch variants.

        config CROWPANEL_P4_PANEL_RGB_800X480
            bool "5-inch (800x480 RGB)"
            help
                Use the 16-bit RGB panel used by the CrowPanel Advanced
                5-inch variant. Its backlight is controlled by the onboard
                STC8 controller over I2C.

    endchoice

    config CROWPANEL_P4_CAMERA
        bool "Enable CrowPanel P4 native camera"
        default y
        depends on CROWPANEL_ADVANCED_P4
        help
            Enable the native MIPI-CSI camera app for the Elecrow CrowPanel
            Advanced P4 boards with the factory camera connector. The camera
            uses the SC2336 sensor wiring documented by Elecrow and is
            independent of whether the display uses MIPI or RGB transport.

    config USE_ILI9341_2
        bool "Use ILI9341 2nd Display Driver"
        default n
        help
            Enable support for ILI9341 display module.

    config USE_C5_PARLIO_DISPLAY
        bool "Use ESP32-C5 PARLIO display transport"
        default n
        depends on IDF_TARGET_ESP32C5 && WITH_SCREEN && LV_TFT_DISPLAY_PROTOCOL_SPI
        help
            Drive the display through the ESP32-C5 PARLIO peripheral in
            single-data-line SPI mode. This leaves SPI2 available for an
            independent SD card bus.

    config C5_PARLIO_CLOCK_HZ
        int "ESP32-C5 PARLIO pixel clock (Hz)"
        default 80000000
        range 1 80000000
        depends on USE_C5_PARLIO_DISPLAY
        help
            Pixel clock used by the ESP32-C5 PARLIO display transport.

    config WITH_STATUS_DISPLAY
        bool "Enable Status Display"
        default n
        help
            Enable the secondary status display that shares the IO expander I2C bus.

    config STATUS_DISPLAY_SDA_PIN
        int "Status Display SDA Pin"
        default 6
        depends on WITH_STATUS_DISPLAY
        help
            Set the SDA pin for the status OLED display (shares IO expander bus).

    config STATUS_DISPLAY_SCL_PIN
        int "Status Display SCL Pin"
        default 7
        depends on WITH_STATUS_DISPLAY
        help
            Set the SCL pin for the status OLED display (shares IO expander bus).

    config STATUS_DISPLAY_I2C_PORT
        int "Status Display I2C Port"
        range 0 1
        default 0
        depends on WITH_STATUS_DISPLAY
        help
            Select the I2C controller port used for the status OLED display.

    config STATUS_DISPLAY_I2C_ADDRESS
        hex "Status Display I2C Address"
        default 0x3C
        depends on WITH_STATUS_DISPLAY
        help
            Set the I2C address for the status OLED.

    config STATUS_DISPLAY_ROTATE_180
        bool "Rotate status display 180 degrees"
        default n
        depends on WITH_STATUS_DISPLAY
        help
            Rotate only the secondary status OLED by 180 degrees. Does not
            affect the primary TFT/touch display.

    config STATUS_DISPLAY_POWER_PIN
        int "Status Display Power Control Pin (Vext)"
        default -1
        depends on WITH_STATUS_DISPLAY
        help
            GPIO pin for power control (e.g., Vext on Heltec V3). Set to -1 to disable.
            For Heltec V3, this should be GPIO36. LOW = display ON, HIGH = display OFF.

    config STATUS_DISPLAY_RESET_PIN
        int "Status Display Reset Pin"
        default -1
        depends on WITH_STATUS_DISPLAY
        help
            GPIO pin for display reset. Set to -1 to disable.
            For Heltec V3, this should be GPIO21.

    config STATUS_DISPLAY_SCALE_Y
        int "Status display vertical scale"
        range 1 2
        default 2
        depends on WITH_STATUS_DISPLAY
        help
            Vertical pixel doubling for status text/animations. 2 = chunky
            double-height glyphs, 1 = native 1:1 pixels (sharper on 128x64
            OLEDs, more rows fit). Horizontal scale is always 1.

    config STATUS_DISPLAY_BUTTON_PIN
        int "Status display animation-cycle button (-1 to disable)"
        default -1
        depends on WITH_STATUS_DISPLAY
        help
            GPIO for a button that cycles the status-display idle animation
            on each press (e.g. Heltec V3 PRG button = GPIO0). Set to -1 to
            disable. Polled with debounce; no extra task is created.

    endmenu

    menu "Misc Options"

        config USE_JOYSTICK
            bool "Enable Joystick"
            default n
            help
                Enable joystick input.

        config USE_ATOMS3R_BUTTON
            bool "Enable AtomS3R single-button navigation"
            default n
            depends on WITH_SCREEN
            help
                Enable the AtomS3R single-button navigation input.

        config ATOMS3R_BUTTON_PIN
            int "AtomS3R button GPIO"
            default 41
            depends on USE_ATOMS3R_BUTTON
            help
                GPIO connected to the AtomS3R user button.
                
        config USE_IO_EXPANDER
            bool "Enable IO Expander (TCA9535)"
            default n
            depends on USE_JOYSTICK
            help
                Enable TCA9535 IO expander for joystick input via I2C.
                
        config IO_EXPANDER_SDA_PIN
            int "IO Expander SDA Pin"
            default 6
            depends on USE_IO_EXPANDER
            help
                Set the SDA pin for the TCA9535 IO expander.
                
        config IO_EXPANDER_SCL_PIN
            int "IO Expander SCL Pin"
            default 7
            depends on USE_IO_EXPANDER
            help
                Set the SCL pin for the TCA9535 IO expander.
                
        config IO_EXPANDER_I2C_ADDR
            hex "IO Expander I2C Address"
            default 0x74
            depends on USE_IO_EXPANDER
            help
                Set the I2C address for the TCA9535 IO expander.
                
        config L_BTN
            int "Left button data pin"
            default 0
            depends on USE_JOYSTICK
            help
                Set the data pin for left button
        config R_BTN
            int "Right button data pin"
            default 0
            depends on USE_JOYSTICK
            help
                Set the data pin for right button
        config U_BTN
            int "Up button data pin"
            default 0
            depends on USE_JOYSTICK
            help
                Set the data pin for up button
        config D_BTN
            int "Down button data pin"
            default 0
            depends on USE_JOYSTICK
            help
                Set the data pin for down button
        config C_BTN
            int "Center button data pin"
            default 0
            depends on USE_JOYSTICK
            help
                Set the data pin for center button

        config JOYSTICK_COM_PIN
            int "Joystick common pin (driven LOW as switch ground)"
            default -1
            depends on USE_JOYSTICK
            help
                Optional common terminal pin for the joystick switch matrix.
                When >= 0, the pin is configured as an output driven LOW so a
                5-way nav stick's COM can be wired to a GPIO instead of GND.
                Set to -1 when the stick's common is hardwired to ground.
                
        config USE_TDECK
            bool "Enable TDECK-plus"
            default n
            help
                Enable tdeck logics.
    
        config USE_CARDPUTER
            bool "Enable Cardputer"
            default n
            help
                Enable Cardputer input.

        config USE_CARDPUTER_ADV
            bool "Enable Cardputer ADV (TCA8418 keyboard)"
            default n
            help
                Enable Cardputer ADV keyboard support using the TCA8418 keypad controller.
        
        config USE_TDISPLAY_S3
            bool "Enable T-Display S3"
            default n
            help
                Enable support for LilyGo T-Display S3 with ST7789 display and CST816 touch.
        
        config USE_HW_KB
            bool "Enable Hardware Keyboard"
            default n
            help
                Enable hardware keyboard input ui elements.

        config USE_USB_KEYBOARD
            bool "Enable USB HID Keyboard (host)"
            default n
            depends on IDF_TARGET_ESP32S3
            help
                Enable USB host HID keyboard support and stream key events over Dual Comm.

        config USB_KBD_DMINUS_PIN
            int "USB Keyboard D- Pin"
            default 19
            depends on USE_USB_KEYBOARD
            help
                GPIO pin for USB D- (keyboard). On ESP32-S3 this is normally GPIO19.

        config USB_KBD_DPLUS_PIN
            int "USB Keyboard D+ Pin"
            default 20
            depends on USE_USB_KEYBOARD
            help
                GPIO pin for USB D+ (keyboard). On ESP32-S3 this is normally GPIO20.

        config HAS_BADUSB
            bool "Enable BadUSB (HID Script Injection)"
            default n
            depends on IDF_TARGET_ESP32S3
            help
                Enable BadUSB support. Uses TinyUSB device mode to emulate a USB HID
                keyboard and execute DuckyScript v1.0 payloads from the SD card.
                Only available on ESP32-S3 which has USB OTG support.

        config HAS_USB_MSC_SD
            bool "USB SD Card Passthrough (TinyUSB MSC)"
            default n
            depends on IDF_TARGET_ESP32S3
            depends on USING_SPI || USING_MMC || USING_MMC_1_BIT
            # The manager includes the TinyUSB MSC headers whenever this
            # feature is selected, so keep the component's class and its
            # generated buffer-size symbol enabled as one feature.
            select TINYUSB_MSC_ENABLED
            help
                Expose the SD card over the native USB port as a mass-storage
                device, turning the board into a USB SD card reader. While
                active, the firmware cannot access the card (it is handed to
                the USB host) and the USB serial console is unavailable.

        config HAS_BADBLE
            bool "Enable BadBLE (Bluetooth HID Script Injection)"
            default y if IDF_TARGET_ESP32 || IDF_TARGET_ESP32C3 || IDF_TARGET_ESP32C5 || IDF_TARGET_ESP32C6 || IDF_TARGET_ESP32S3 || IDF_TARGET_ESP32P4
            depends on !IDF_TARGET_ESP32S2
            depends on SOC_BT_SUPPORTED || ESP_HOSTED_ENABLE_BT_NIMBLE
            depends on BT_ENABLED
            depends on BT_NIMBLE_ENABLED
            depends on BT_CONTROLLER_ENABLED || ESP_HOSTED_ENABLE_BT_NIMBLE
            depends on BT_NIMBLE_ROLE_PERIPHERAL
            depends on BT_NIMBLE_GATT_SERVER
            select BT_NIMBLE_HID_SERVICE
            help
                Enable native BLE HID keyboard support for DuckyScript payloads.
                Uses the NimBLE HID service and is available on Bluetooth-capable
                targets with a NimBLE GATT server.

        config BADUSB_VSENSE_PIN
            int "BadUSB VBUS Sense Pin (use -1 to disable)"
            default -1
            depends on HAS_BADUSB
            help
                GPIO pin to sense USB VBUS voltage. When set to a valid pin (>= 0),
                BadUSB will wait for VBUS to go HIGH before executing a script,
                allowing you to plug in the device after selecting a payload.
                Set to -1 to disable and execute immediately.

        config HAS_BADUSB_REMOTE
            bool "Enable BadUSB Remote (display menu only, routes via GhostLink)"
            default n
            depends on IDF_TARGET_ESP32C5
            help
                Enable the BadUSB display menu on a C5 display controller that routes
                commands to a paired S3 via GhostLink/commsend. The C5 does not execute
                scripts itself - it only provides the UI.

        config HAS_NRF24_REMOTE
            bool "Enable NRF24 Remote (display controls via GhostLink peer)"
            default n
            help
                Enable NRF24 analyzer controls on a display controller that routes
                commands to a paired NRF24-capable peer over GhostLink/commsend.
                The display device does not scan RF directly - it only provides the UI.

        config HAS_SUBGHZ_REMOTE
            bool "Enable SubGHz Remote (display controls via GhostLink peer)"
            default n
            help
                Enable SubGHz scanner controls on a display controller that routes
                commands to a paired CC1101-capable peer over GhostLink/commsend.
                The display device does not scan RF directly - it only provides the UI.

        config HAS_BATTERY
            bool "Enable power saving"
            default n
            help
                Enable power saving features if you have a battery.


        config HAS_BATTERY_ADC
            bool "Enable battery ADC reading"
            default n
            help
                Enable ADC battery readings
                
        config ADC_BATTERY_PIN
            int "Pin for reading ADC measurements"
            default -1
            depends on HAS_BATTERY_ADC
            help
                Set ADC battery pin (GPIO4 for T-Deck, GPIO10 for Cardputer)

        config HAS_FUEL_GAUGE
            bool "Enable Fuel Gauge Support"
            default n
            help
                Enable fuel gauge support for accurate battery monitoring.

        config USE_BQ27220_FUEL_GAUGE
            bool "Use BQ27220 Fuel Gauge"
            default n
            depends on HAS_FUEL_GAUGE
            help
                Enable support for BQ27220 fuel gauge via I2C.

        config BQ27220_I2C_ADDRESS
            hex "BQ27220 I2C Address"
            default 0x55
            depends on USE_BQ27220_FUEL_GAUGE
            help
                I2C address for BQ27220 fuel gauge (default 0x55).

        config BQ27220_I2C_SDA_PIN
            int "BQ27220 I2C SDA Pin"
            default 8
            depends on USE_BQ27220_FUEL_GAUGE
            help
                GPIO pin for BQ27220 I2C SDA line.

        config BQ27220_I2C_SCL_PIN
            int "BQ27220 I2C SCL Pin"
            default 18
            depends on USE_BQ27220_FUEL_GAUGE
            help
                GPIO pin for BQ27220 I2C SCL line.

        config BQ27220_DESIGN_CAPACITY
            int "Battery Design Capacity (mAh)"
            default 1300
            depends on USE_BQ27220_FUEL_GAUGE
            help
                Design capacity of the battery in mAh (default 1300 for T-Embed CC1101).

        config USE_MAX17048_FUEL_GAUGE
            bool "Use MAX17048 Fuel Gauge"
            default n
            depends on HAS_FUEL_GAUGE
            help
                Enable support for MAX17048 fuel gauge via I2C.

        config MAX17048_I2C_ADDRESS
            hex "MAX17048 I2C Address"
            default 0x36
            depends on USE_MAX17048_FUEL_GAUGE
            help
                I2C address for MAX17048 fuel gauge (default 0x36).

        config MAX17048_I2C_SDA_PIN
            int "MAX17048 I2C SDA Pin"
            default 6
            depends on USE_MAX17048_FUEL_GAUGE
            help
                GPIO pin for MAX17048 I2C SDA line.

        config MAX17048_I2C_SCL_PIN
            int "MAX17048 I2C SCL Pin"
            default 7
            depends on USE_MAX17048_FUEL_GAUGE
            help
                GPIO pin for MAX17048 I2C SCL line.
    
        config HAS_RTC_CLOCK
            bool "Enable RTC Clock"
            default n
            help
                Enable RTC Clock.

        config RTC_I2C_SDA_PIN
            int "RTC SDA Pin"
            default 6
            depends on HAS_RTC_CLOCK
            help
                Set the SDA pin for the RTC I2C communication.

        config RTC_I2C_SCL_PIN
            int "RTC SCL Pin"
            default 7
            depends on HAS_RTC_CLOCK
            help
                Set the SCL pin for the RTC I2C communication.

        config RTC_I2C_ADDRESS
            hex "RTC I2C Address"
            default 0x68
            depends on HAS_RTC_CLOCK
            help
                Set the I2C address for the RTC chip (e.g., 0x68 for DS1307/DS3231, 0x51 for PCF8563).

        config RTC_I2C_PORT
            int "RTC I2C Port"
            range 0 1
            default 0
            depends on HAS_RTC_CLOCK
            help
                Select the I2C controller port used for the RTC.

        config RTC_CHIP_TYPE
            int "RTC Chip Type"
            range 0 2
            default 1
            depends on HAS_RTC_CLOCK
            help
                Select the RTC chip type:
                0 = PCF8563 (address 0x51)
                1 = DS1307 (address 0x68) 
                2 = DS3231 (address 0x68)

        config WITH_ETHERNET
            bool "Enable Ethernet Support"
            default n
            help
                Enable Ethernet Support.
                
        config ETH_W5500_MOSI_PIN
            int "W5500 MOSI Pin"
            default 6
            depends on WITH_ETHERNET
            help
                Set the GPIO pin for W5500 MOSI (Master Out Slave In).
                
        config ETH_W5500_MISO_PIN
            int "W5500 MISO Pin"
            default 5
            depends on WITH_ETHERNET
            help
                Set the GPIO pin for W5500 MISO (Master In Slave Out).
                
        config ETH_W5500_SCK_PIN
            int "W5500 SCK Pin"
            default 4
            depends on WITH_ETHERNET
            help
                Set the GPIO pin for W5500 SCK (Serial Clock).
                
        config ETH_W5500_CS_PIN
            int "W5500 CS Pin"
            default 15
            depends on WITH_ETHERNET
            help
                Set the GPIO pin for W5500 CS (Chip Select).
                
        config ETH_W5500_INT_PIN
            int "W5500 INT Pin (optional, use -1 to disable)"
            default 7
            depends on WITH_ETHERNET
            help
                Set the GPIO pin for W5500 INT (Interrupt). Use -1 if not connected.

        config ETH_W5500_SPI_HOST
            int "W5500 SPI Host (2=SPI2, 3=SPI3)"
            default 3
            depends on WITH_ETHERNET
            help
                SPI host to use for the W5500 Ethernet chip.
                2 = SPI2_HOST, 3 = SPI3_HOST (default).
                Set to 2 if SPI3 is already used by another peripheral (e.g. NRF24).

        config IS_GHOST_BOARD
            bool "Enable Ghost Board Configuration"
            default n
            help
                Enable configuration for Ghost board.

        config IS_S3TWATCH
            bool "Enable S3TWatch Configuration"
            default n
            help
                Enable configuration for S3TWatch with virtual flash storage.

        config IS_ATOMS3R
            bool "Enable M5Stack AtomS3R Configuration"
            default n
            help
                Enable configuration for the M5Stack AtomS3R. Like the
                S3TWatch, it has no SD card slot, so the build carves out a
                flash 'storage' partition mounted as virtual storage at /mnt.

        config HAS_DRV2605_HAPTICS
            bool "Enable DRV2605 Haptics"
            default y if IS_S3TWATCH
            default n
            help
                Enable a DRV2605 haptic motor driver for tactile UI feedback.

        config DRV2605_I2C_SDA_PIN
            int "DRV2605 I2C SDA Pin"
            default 10 if IS_S3TWATCH
            default -1
            depends on HAS_DRV2605_HAPTICS
            help
                GPIO pin used for DRV2605 I2C SDA.

        config DRV2605_I2C_SCL_PIN
            int "DRV2605 I2C SCL Pin"
            default 11 if IS_S3TWATCH
            default -1
            depends on HAS_DRV2605_HAPTICS
            help
                GPIO pin used for DRV2605 I2C SCL.

        config DRV2605_I2C_PORT
            int "DRV2605 I2C Port"
            range 0 1
            default 1 if IS_S3TWATCH
            default 0
            depends on HAS_DRV2605_HAPTICS
            help
                I2C controller port used for DRV2605 haptics.

        config DRV2605_I2C_ADDRESS
            hex "DRV2605 I2C Address"
            default 0x5A
            depends on HAS_DRV2605_HAPTICS
            help
                7-bit I2C address for the DRV2605 haptic driver.

        config DRV2605_I2C_PULLUPS
            bool "Enable DRV2605 I2C Internal Pullups"
            default y
            depends on HAS_DRV2605_HAPTICS
            help
                Enable ESP internal pullups on the DRV2605 I2C bus.

        config DRV2605_LRA_MODE
            bool "DRV2605 LRA Mode (linear resonance actuator)"
            default y if IS_S3TWATCH
            default n
            depends on HAS_DRV2605_HAPTICS
            help
                Enable LRA mode and LRA waveform library for the DRV2605.
                The LilyGo T-Watch S3 haptic motor is an LRA. Only flip
                this off if your hardware uses an ERM (eccentric rotating mass).

        config HAS_INFRARED
            bool "Enable Infrared Support"
            default n
            help
                Enable infrared hardware and UI support.

        config INFRARED_LED_PIN
            int "Infrared LED Pin"
            default 0
            depends on HAS_INFRARED
            help
                Set the GPIO pin used for IR LED transmission and indication.

        config HAS_INFRARED_RX
            bool "Enable Infrared Receive Support"
            default n
            depends on HAS_INFRARED
            help
                Enable infrared receive functionality for learning remote signals.

        config INFRARED_RX_PIN
            int "Infrared RX Pin"
            default 0
            depends on HAS_INFRARED_RX
            help
                Set the GPIO pin used for IR signal reception.

        config USE_ENCODER
            bool "Enable Encoder Input"
            default n
            help
                Enable support for rotary encoder input.

        config ENCODER_INA
            int "Encoder INA Pin"
            default 4
            depends on USE_ENCODER
            help
                Set the GPIO pin for Encoder INA.

        config ENCODER_INB
            int "Encoder INB Pin"
            default 5
            depends on USE_ENCODER
            help
                Set the GPIO pin for Encoder INB.

        config ENCODER_KEY
            int "Encoder Key Pin"
            default 0
            depends on USE_ENCODER
            help
                Set the GPIO pin for the Encoder button.

        menu "NRF24 Options"

            config HAS_NRF24
                bool "Enable NRF24 App"
                default n
                help
                    Enable the NRF24 app menu and frequency analyzer view.

            config NRF24_SPI_HOST
                int "NRF24 SPI Host"
                range 2 3
                default 2
                depends on HAS_NRF24
                help
                    SPI host for NRF24 (2 = SPI2_HOST, 3 = SPI3_HOST).

            config NRF24_SPI_MOSI_PIN
                int "NRF24 MOSI Pin"
                default 14
                depends on HAS_NRF24
                help
                    GPIO pin for NRF24 MOSI.

            config NRF24_SPI_MISO_PIN
                int "NRF24 MISO Pin"
                default 21
                depends on HAS_NRF24
                help
                    GPIO pin for NRF24 MISO.

            config NRF24_SPI_SCK_PIN
                int "NRF24 SCK Pin"
                default 13
                depends on HAS_NRF24
                help
                    GPIO pin for NRF24 SCK.

            config NRF24_CSN_PIN
                int "NRF24 CSN Pin"
                default 12
                depends on HAS_NRF24
                help
                    GPIO pin for NRF24 CSN.

            config NRF24_CE_PIN
                int "NRF24 CE Pin"
                default 11
                depends on HAS_NRF24
                help
                    GPIO pin for NRF24 CE.

            config NRF24_SPI_CLOCK_HZ
                int "NRF24 SPI Clock (Hz)"
                range 1000000 10000000
                default 8000000
                depends on HAS_NRF24
                help
                    SPI clock used to communicate with the NRF24L01 module.

            config NRF24_ANALYZER_SAMPLES_PER_CHANNEL
                int "Analyzer Samples per Channel"
                range 1 16
                default 6
                depends on HAS_NRF24
                help
                    Number of RPD samples taken for each channel update.
                    Higher values give finer level quantization (less
                    jitter) at the cost of scan speed.

            config NRF24_ANALYZER_SETTLE_US
                int "Analyzer Settle Time (us)"
                range 130 5000
                default 250
                depends on HAS_NRF24
                help
                    Delay after setting channel before reading RPD. Too
                    short and the PLL hasn't relocked, so RPD can still
                    reflect the previous channel (reads as jitter/crosstalk
                    between adjacent channels).

            config NRF24_ANALYZER_CHANNELS_PER_TICK
                int "Analyzer Channels per Tick"
                range 1 32
                default 8
                depends on HAS_NRF24
                help
                    Number of channels processed each analyzer timer tick.

        endmenu

        menu "SubGHz Options"

            config HAS_SUBGHZ
                bool "Enable SubGHz App (CC1101)"
                default n
                help
                    Enable the SubGHz app menu, popup scanner UI, and CC1101 backend.

            config SUBGHZ_SPI_HOST
                int "SubGHz SPI Host"
                range 2 3
                default 2
                depends on HAS_SUBGHZ
                help
                    SPI host for CC1101 (2 = SPI2_HOST, 3 = SPI3_HOST).

            config SUBGHZ_SPI_MOSI_PIN
                int "SubGHz MOSI Pin"
                default 18
                depends on HAS_SUBGHZ
                help
                    GPIO pin for CC1101 MOSI.

            config SUBGHZ_SPI_MISO_PIN
                int "SubGHz MISO Pin"
                default 38
                depends on HAS_SUBGHZ
                help
                    GPIO pin for CC1101 MISO.

            config SUBGHZ_SPI_SCK_PIN
                int "SubGHz SCK Pin"
                default 40
                depends on HAS_SUBGHZ
                help
                    GPIO pin for CC1101 SCK.

            config SUBGHZ_CSN_PIN
                int "SubGHz CSN Pin"
                default 39
                depends on HAS_SUBGHZ
                help
                    GPIO pin for CC1101 CSN (chip select).

            config SUBGHZ_GDO0_PIN
                int "SubGHz GDO0 Pin"
                default 41
                depends on HAS_SUBGHZ
                help
                    GPIO pin connected to CC1101 GDO0.

            config SUBGHZ_GDO2_PIN
                int "SubGHz GDO2 Pin (optional, -1 to disable)"
                default -1
                depends on HAS_SUBGHZ
                help
                    Optional GPIO pin connected to CC1101 GDO2.

            config SUBGHZ_SPI_CLOCK_HZ
                int "SubGHz SPI Clock (Hz)"
                range 500000 10000000
                default 4000000
                depends on HAS_SUBGHZ
                help
                    SPI clock used to communicate with the CC1101 module.

            config SUBGHZ_BASE_FREQ_MHZ
                int "SubGHz Base Frequency (MHz * 100)"
                range 30000 92800
                default 43392
                depends on HAS_SUBGHZ
                help
                    Base tuning frequency in MHz*100 (e.g. 43392 = 433.92 MHz).

            config SUBGHZ_CHANNEL_STEP_KHZ
                int "SubGHz Channel Step (kHz)"
                range 25 500
                default 200
                depends on HAS_SUBGHZ
                help
                    Approximate channel step shown by the UI while scanning.

            config SUBGHZ_ANALYZER_CHANNELS_PER_TICK
                int "SubGHz Channels per Tick"
                range 1 32
                default 8
                depends on HAS_SUBGHZ
                help
                    Number of channels sampled each scanner task tick.

            config SUBGHZ_ANALYZER_SETTLE_US
                int "SubGHz Settle Time (us)"
                range 100 5000
                default 250
                depends on HAS_SUBGHZ
                help
                    Delay after tuning a channel before reading RSSI.

        endmenu

        menu "LoRa Options"

            config HAS_LORA
                bool "Enable LoRa App (SX1262/SX1276/LLCC68)"
                default n
                help
                    Enable the LoRa app: lora CLI, WebUI commands, LVGL view
                    (screened boards), and SX1262-family backend with stock
                    Meshtastic air framing and BLE PhoneAPI app support.

            config LORA_SPI_HOST
                int "LoRa SPI Host"
                range 2 3
                default 2
                depends on HAS_LORA
                help
                    SPI host for LoRa radio (2 = SPI2_HOST, 3 = SPI3_HOST).

            config LORA_SPI_MOSI_PIN
                int "LoRa MOSI Pin"
                default 10
                depends on HAS_LORA
                help
                    GPIO for LoRa MOSI (Heltec V3 default 10).

            config LORA_SPI_MISO_PIN
                int "LoRa MISO Pin"
                default 11
                depends on HAS_LORA
                help
                    GPIO for LoRa MISO (Heltec V3 default 11).

            config LORA_SPI_SCK_PIN
                int "LoRa SCK Pin"
                default 9
                depends on HAS_LORA
                help
                    GPIO for LoRa SCK (Heltec V3/V3.2 default 9).

            config LORA_NSS_PIN
                int "LoRa NSS Pin"
                default 8
                depends on HAS_LORA
                help
                    GPIO for LoRa chip select (Heltec V3/V3.2 default 8).

            config LORA_DIO1_PIN
                int "LoRa DIO1 Pin"
                default 14
                depends on HAS_LORA
                help
                    GPIO for LoRa DIO1 IRQ (Heltec V3 default 14).

            config LORA_BUSY_PIN
                int "LoRa BUSY Pin"
                default 13
                depends on HAS_LORA
                help
                    GPIO for LoRa BUSY (Heltec V3 default 13).

            config LORA_RST_PIN
                int "LoRa RST Pin (-1 to disable)"
                default 12
                depends on HAS_LORA
                help
                    GPIO for LoRa reset (Heltec V3 default 12).

            config LORA_VEXT_PIN
                int "LoRa radio power pin / Vext (-1 to disable)"
                default -1
                depends on HAS_LORA
                help
                    GPIO that powers the LoRa radio rail (e.g. Vext on Heltec
                    V3 = GPIO36, shared with the OLED). Driven before SPI
                    bring-up so the radio never probes unpowered. Set to -1
                    when the rail is always on.

            config LORA_VEXT_ACTIVE_LOW
                bool "LoRa Vext is active-low"
                default y
                depends on HAS_LORA
                help
                    y = drive LOW to power the radio (Heltec Vext),
                    n = drive HIGH.

            config LORA_ENABLE_PIN
                int "LoRa wireless-module enable pin (-1 to disable)"
                default -1
                depends on HAS_LORA
                help
                    Optional board pin that selects the wireless-module
                    function before radio bring-up. Elecrow CrowPanel Advance
                    2.4/2.8 uses GPIO45 active-low; leave -1 for integrated
                    radios and modules that are always selected.

            config LORA_ENABLE_ACTIVE_LOW
                bool "LoRa wireless-module enable is active-low"
                default y
                depends on HAS_LORA && LORA_ENABLE_PIN >= 0
                help
                    y = drive the enable pin LOW to select the radio,
                    n = drive it HIGH.

            choice LORA_MODULE
                prompt "LoRa module"
                depends on HAS_LORA
                default LORA_MODULE_SX1262

                config LORA_MODULE_SX1262
                    bool "SX1262"

                config LORA_MODULE_SX1276
                    bool "SX1276"

                config LORA_MODULE_LLCC68
                    bool "LLCC68"
            endchoice

            choice LORA_TCXO_VOLTAGE
                prompt "SX126x DIO3 TCXO voltage"
                depends on HAS_LORA
                default LORA_TCXO_1V8
                help
                    Voltage selected by the SX126x SetDIO3AsTCXOCtrl command.
                    Heltec V3 uses 1.8 V; the Elecrow CrowPanel wireless
                    Meshtastic module uses 3.3 V. Select disabled only for a
                    module with a crystal or externally powered oscillator.

                config LORA_TCXO_DISABLED
                    bool "Disabled / crystal"

                config LORA_TCXO_1V8
                    bool "1.8 V (Heltec V3)"

                config LORA_TCXO_3V3
                    bool "3.3 V (Elecrow CrowPanel module)"
            endchoice

            config LORA_MAX_TX_DBM
                int "LoRa max TX (dBm)"
                range 2 22
                default 17
                depends on HAS_LORA
                help
                    Board/regulatory TX cap enforced by the manager.

            config LORA_MSG_RING
                int "LoRa message ring entries"
                range 4 32
                default 32
                depends on HAS_LORA
                help
                    Retained chat messages (32 by default; fixed RAM ring).

            choice LORA_REGION_DEFAULT
                prompt "LoRa default region (first flash only; `lora set region` after)"
                depends on HAS_LORA
                default LORA_REGION_US915

                config LORA_REGION_US915
                    bool "US915"
                config LORA_REGION_EU868
                    bool "EU868"
                config LORA_REGION_EU433
                    bool "EU433"
                config LORA_REGION_CN
                    bool "CN"
                config LORA_REGION_JP
                    bool "JP"
                config LORA_REGION_ANZ
                    bool "ANZ (AU/NZ 915)"
                config LORA_REGION_KR
                    bool "KR"
                config LORA_REGION_TW
                    bool "TW"
                config LORA_REGION_RU
                    bool "RU"
                config LORA_REGION_IN
                    bool "IN"
                config LORA_REGION_NZ865
                    bool "NZ865"
                config LORA_REGION_TH
                    bool "TH"
                config LORA_REGION_UA433
                    bool "UA433"
                config LORA_REGION_MY433
                    bool "MY433"
                config LORA_REGION_MY919
                    bool "MY919"
                config LORA_REGION_SG923
                    bool "SG923"
                config LORA_REGION_PH433
                    bool "PH433"
                config LORA_REGION_PH868
                    bool "PH868"
                config LORA_REGION_PH915
                    bool "PH915"
                config LORA_REGION_ANZ433
                    bool "ANZ433"
                config LORA_REGION_KZ433
                    bool "KZ433"
                config LORA_REGION_KZ863
                    bool "KZ863"
                config LORA_REGION_NP865
                    bool "NP865"
                config LORA_REGION_BR902
                    bool "BR902"
            endchoice

        endmenu

        menu "NFC Options"

            config NFC_PN532
                bool "Enable PN532 NFC support"
                default n
                help
                    Compile PN532 NFC support.

            config NFC_ST25R3916
                bool "Enable ST25R3916 NFC support"
                default n
                help
                    Compile ST25R3916/ST25R3916B NFC support.

            choice NFC_DEFAULT_BACKEND
                prompt "Default local NFC backend"
                depends on NFC_PN532 || NFC_ST25R3916
                default NFC_DEFAULT_BACKEND_PN532 if NFC_PN532
                default NFC_DEFAULT_BACKEND_ST25R3916 if NFC_ST25R3916
                default NFC_DEFAULT_BACKEND_AUTO

                config NFC_DEFAULT_BACKEND_AUTO
                    bool "Auto"

                config NFC_DEFAULT_BACKEND_PN532
                    bool "PN532"
                    depends on NFC_PN532

                config NFC_DEFAULT_BACKEND_ST25R3916
                    bool "ST25R3916"
                    depends on NFC_ST25R3916
            endchoice


            choice NFC_ST25R3916_BUS
                prompt "ST25R3916 bus"
                depends on NFC_ST25R3916
                default NFC_ST25R3916_I2C

                config NFC_ST25R3916_I2C
                    bool "I2C"

                config NFC_ST25R3916_SPI
                    bool "SPI"
            endchoice

            config NFC_CHAMELEON
                bool "Enable Chameleon Ultra NFC"
                default y if BT_BLE_ENABLED
                default n
                help
                    Enable using Chameleon Ultra as an NFC backend over BLE.

            # Aggregated flag for UI and generic NFC code
            config HAS_NFC
                bool
                default y if NFC_PN532 || NFC_ST25R3916 || NFC_CHAMELEON

            config NFC_SCL_PIN
                int "NFC Clock Pin (SCL/SCK)"
                default 22
                depends on NFC_PN532 || (NFC_ST25R3916 && NFC_ST25R3916_I2C)
                help
                    GPIO for NFC I2C clock (SCL).

            config NFC_SDA_PIN
                int "NFC Data Pin (SDA)"
                default 21
                depends on NFC_PN532 || (NFC_ST25R3916 && NFC_ST25R3916_I2C)
                help
                    GPIO for NFC I2C data (SDA).

            config NFC_IRQ_PIN
                int "NFC URQ/IRQ Pin"
                default -1
                depends on NFC_PN532 || NFC_ST25R3916
                help
                    GPIO for NFC IRQ/URQ. Use -1 if not connected.

            config NFC_RST_PIN
                int "NFC RF RST Pin"
                default -1
                depends on NFC_PN532 || NFC_ST25R3916
                help
                    GPIO for NFC reset. Use -1 if not connected.

            config NFC_ST25R3916_I2C_ADDR
                hex "ST25R3916 I2C address"
                default 0x50
                depends on NFC_ST25R3916 && NFC_ST25R3916_I2C
                help
                    7-bit ST25R3916 I2C address. The chip uses 0x50..0x53 depending on A0/A1 straps.

            config NFC_ST25R3916_I2C_PORT
                int "ST25R3916 I2C port"
                default 0
                range 0 1
                depends on NFC_ST25R3916 && NFC_ST25R3916_I2C
                help
                    I2C controller port used for the ST25R3916. Boards with the
                    internal peripherals on port 0 (e.g. M5Stack CoreS3-SE, AtomS3R)
                    should use port 1 for a Grove-port reader.

            config NFC_ST25R3916_SPI_HOST
                int "ST25R3916 SPI host"
                default 1
                depends on NFC_ST25R3916 && NFC_ST25R3916_SPI
                help
                    ESP-IDF SPI host index (typically 1 for SPI2_HOST, 2 for SPI3_HOST).

            config NFC_ST25R3916_SPI_MOSI_PIN
                int "ST25R3916 SPI MOSI pin"
                default -1
                depends on NFC_ST25R3916 && NFC_ST25R3916_SPI

            config NFC_ST25R3916_SPI_MISO_PIN
                int "ST25R3916 SPI MISO pin"
                default -1
                depends on NFC_ST25R3916 && NFC_ST25R3916_SPI

            config NFC_ST25R3916_SPI_SCLK_PIN
                int "ST25R3916 SPI SCLK pin"
                default -1
                depends on NFC_ST25R3916 && NFC_ST25R3916_SPI

            config NFC_ST25R3916_SPI_CS_PIN
                int "ST25R3916 SPI CS pin"
                default -1
                depends on NFC_ST25R3916 && NFC_ST25R3916_SPI

            config NFC_ST25R3916_SPI_CLOCK_HZ
                int "ST25R3916 SPI clock (Hz)"
                default 4000000
                range 100000 6000000
                depends on NFC_ST25R3916 && NFC_ST25R3916_SPI

        endmenu

    endmenu

    menu "Camera & Motion Detector Configuration"
        depends on IDF_TARGET_ESP32S3

        config HAS_CAMERA
            bool "Enable Camera Support"
            default n
            help
                Enable camera sensor (e.g. OV3660 on XIAO ESP32S3 Sense)

        config CAM_PIN_PWDN
            int "Camera PWDN Pin"
            depends on HAS_CAMERA
            default -1
            help
                Power-down pin (-1 if not connected)

        config CAM_PIN_RESET
            int "Camera RESET Pin"
            depends on HAS_CAMERA
            default -1
            help
                Reset pin (-1 if not connected)

        config CAM_PIN_XCLK
            int "Camera XCLK Pin"
            depends on HAS_CAMERA
            default 10
            help
                Master clock output pin

        config CAM_PIN_SIOD
            int "Camera SCCB SDA Pin"
            depends on HAS_CAMERA
            default 40
            help
                SCCB/I2C data pin

        config CAM_PIN_SIOC
            int "Camera SCCB SCL Pin"
            depends on HAS_CAMERA
            default 39
            help
                SCCB/I2C clock pin

        config CAM_PIN_D7
            int "Camera D7 Pin"
            depends on HAS_CAMERA
            default 48
            help
                Parallel data bit 7

        config CAM_PIN_D6
            int "Camera D6 Pin"
            depends on HAS_CAMERA
            default 11
            help
                Parallel data bit 6

        config CAM_PIN_D5
            int "Camera D5 Pin"
            depends on HAS_CAMERA
            default 12
            help
                Parallel data bit 5

        config CAM_PIN_D4
            int "Camera D4 Pin"
            depends on HAS_CAMERA
            default 14
            help
                Parallel data bit 4

        config CAM_PIN_D3
            int "Camera D3 Pin"
            depends on HAS_CAMERA
            default 16
            help
                Parallel data bit 3

        config CAM_PIN_D2
            int "Camera D2 Pin"
            depends on HAS_CAMERA
            default 18
            help
                Parallel data bit 2

        config CAM_PIN_D1
            int "Camera D1 Pin"
            depends on HAS_CAMERA
            default 17
            help
                Parallel data bit 1

        config CAM_PIN_D0
            int "Camera D0 Pin"
            depends on HAS_CAMERA
            default 15
            help
                Parallel data bit 0

        config CAM_PIN_VSYNC
            int "Camera VSYNC Pin"
            depends on HAS_CAMERA
            default 38
            help
                Vertical sync pin

        config CAM_PIN_HREF
            int "Camera HREF Pin"
            depends on HAS_CAMERA
            default 47
            help
                Horizontal reference pin

        config CAM_PIN_PCLK
            int "Camera PCLK Pin"
            depends on HAS_CAMERA
            default 13
            help
                Pixel clock pin

        config MOTION_DETECT_THRESHOLD
            int "Motion Detection Threshold"
            depends on HAS_CAMERA
            default 30
            help
                Pixel difference threshold (0-255). Lower = more sensitive.

        config MOTION_DETECT_INTERVAL_MS
            int "Motion Detection Interval (ms)"
            depends on HAS_CAMERA
            default 500
            help
                Milliseconds between motion detection frames.

        config MOTION_DETECT_PERCENT
            int "Motion Detection Trigger Percent"
            depends on HAS_CAMERA
            default 10
            help
                Percentage of pixels that must change to trigger motion (0-100).

        config MOTION_DETECT_SAMPLE_STEP
            int "Motion Detection Sample Step"
            depends on HAS_CAMERA
            default 4
            help
                Compare every Nth pixel. Higher values are faster but less precise.

        config MOTION_WEBHOOK_COOLDOWN_MS
            int "Motion Webhook Cooldown (ms)"
            depends on HAS_CAMERA
            default 60000
            help
                Minimum time between webhook alerts.
    endmenu

    menu "Microphone Configuration"
        depends on !CONFIG_USE_NEOPIXEL

        config HAS_MIC
            bool "Enable Microphone Support"
            default n
            help
                Enable I2S microphone for audio capture

        config MIC_I2S_BCLK_PIN
            int "I2S BCLK Pin"
            depends on HAS_MIC
            default 4
            help
                BCLK pin for I2S microphone (INMP441)

        config MIC_I2S_WS_PIN
            int "I2S WS/LRCLK Pin"
            depends on HAS_MIC
            default 5
            help
                WS/LRCLK pin for I2S microphone (INMP441)

        config MIC_I2S_DIN_PIN
            int "I2S Data In Pin"
            depends on HAS_MIC
            default 6
            help
                DIN pin for I2S microphone (INMP441)

        config MIC_I2S_MCLK_PIN
            int "I2S MCLK pin"
            depends on HAS_MIC
            default -1
            help
                MCLK pin for codecs that require a master clock.

        config MIC_I2S_PORT
            int "I2S port"
            range 0 1
            depends on HAS_MIC
            default 0
            help
                I2S controller used by the microphone.

        config MIC_SAMPLE_RATE
            int "Sample Rate"
            depends on HAS_MIC
            default 16000
            help
                I2S sample rate in Hz (16000 recommended for voice)

        config MIC_BUFFER_SAMPLES
            int "Samples per read"
            depends on HAS_MIC
            default 512
            help
                Number of samples to read per I2S transaction
    endmenu
    
    menu "GPS Configuration"
    
    config HAS_GPS
        bool "Enable GPS"
        default n
        help
            Enable GPS support.
    
    config GPS_UART_RX_PIN
        int "GPS UART RX Pin"
        default 16
        depends on HAS_GPS
        help
            Define the UART RX pin for GPS.
    
    config GPS_UART_BAUD_RATE
        int "Set baud rate for gps serial"
        default 9600
        depends on HAS_GPS
        help
            Define the UART RX pin baud rate for GPS.

    config NMEA_PARSER_RING_BUFFER_SIZE
        int "NMEA Parser Ring Buffer Size"
        range 0 2048
        depends on HAS_GPS
        default 1024
        help
            Size of the ring buffer used for UART Rx channel.

    config NMEA_PARSER_TASK_STACK_SIZE
        int "NMEA Parser Task Stack Size"
        range 0 4096
        depends on HAS_GPS
        default 3072
        help
            Stack size of NMEA Parser task.

    config NMEA_PARSER_TASK_PRIORITY
        int "NMEA Parser Task Priority"
        range 0 24
        depends on HAS_GPS
        default 2
        help
            Priority of NMEA Parser task.

    menu "NMEA Statement Support"
        comment "At least one statement must be selected"
        config NMEA_STATEMENT_GGA
            bool "GGA Statement"
            default y
            depends on HAS_GPS
            help
                Enabling this option will parse the following parameter from GGA statement:

                - Latitude, Longitude, Altitude;
                - Number of satellites in use, fix status (no fix, GPS, DGPS), UTC time;

        config NMEA_STATEMENT_GSA
            bool "GSA Statement"
            default y
            depends on HAS_GPS
            help
                Enabling this option will parse the following parameter from GSA statement:

                - Position/Vertical/Horizontal dilution of precision;
                - Fix mode (no fix, 2D, 3D fix);
                - IDs of satellites in use;

        config NMEA_STATEMENT_GSV
            bool "GSV Statement"
            default y
            depends on HAS_GPS
            help
                Enabling this option will parse the following parameter from GSV statement:

                - Number of satellites in view;
                - Optional details of each satellite in view;

        config NMEA_STATEMENT_RMC
            bool "RMC Statement"
            default y
            depends on HAS_GPS
            help
                Enabling this option will parse the following parameter from RMC statement:

                - Validity of GPS signal;
                - Ground speed (knots) and course over ground (degrees);
                - Magnetic variation;
                - UTC date;

        config NMEA_STATEMENT_GLL
            bool "GLL Statement"
            default y
            depends on HAS_GPS
            help
                Enabling this option will parse the following parameter from GLL statement:

                - Latitude, Longitude;
                - UTC time;

        config NMEA_STATEMENT_VTG
            bool "VTG Statement"
            default y
            depends on HAS_GPS
            help
                Enabling this option will parse the following parameter from VTG statement:

                - Ground speed (knots, km/h) and course over ground (degrees);
                - Magnetic variation;

    endmenu
    
    endmenu
    
    menu "Compass Configuration"

    config HAS_COMPASS
        bool "Enable Compass App"
        default n
        help
            Enable Compass application using QMC6309.

    config COMPASS_I2C_ADDR
        hex "QMC6309 I2C Address"
        default 0x0D
        depends on HAS_COMPASS
        help
            I2C address of the QMC6309 magnetometer.

    config COMPASS_USE_BMM150
        bool "Use BMM150 magnetometer"
        default n
        depends on HAS_COMPASS
        help
            Use a BMM150 on the native I2C bus instead of the QMC6309.
            The existing QMC6309 compass path remains the default.

    config BMM150_I2C_ADDR
        hex "BMM150 I2C Address"
        default 0x10
        depends on COMPASS_USE_BMM150
        help
            I2C address of the BMM150 magnetometer (0x10 or 0x11).

    config COMPASS_ON_EXPANDER
        bool "Compass connected to IO Expander"
        default y
        depends on HAS_COMPASS
        help
            Set to true if the Compass is connected to the IO Expander pins (requiring bit-banged I2C).

    config COMPASS_EXPANDER_ADDR
        hex "Compass IO Expander Address"
        default 0x7C
        depends on COMPASS_ON_EXPANDER
        help
            I2C address of the IO Expander hosting the Compass.

    config COMPASS_SCL_PIN_BIT
        int "Compass SCL Pin Bit (Port 1)"
        default 6
        depends on COMPASS_ON_EXPANDER
        help
            Bit index (0-7) on Port 1 for SCL.

    config COMPASS_SDA_PIN_BIT
        int "Compass SDA Pin Bit (Port 1)"
        default 7
        depends on COMPASS_ON_EXPANDER
        help
            Bit index (0-7) on Port 1 for SDA.

    config QMC6309_CALIB_X_OFFSET
        int "X Offset"
        default 0
        depends on HAS_COMPASS

    config QMC6309_CALIB_Y_OFFSET
        int "Y Offset"
        default 0
        depends on HAS_COMPASS

    config QMC6309_CALIB_Z_OFFSET
        int "Z Offset"
        default 0
        depends on HAS_COMPASS

    endmenu

    menu "ENV-III Sensor Configuration"

    config HAS_ENVIII
        bool "Enable ENV-III App"
        default n
        help
            Enable ENV-III application using SHT30 and QMP6988 sensors.

    config ENVIII_SHT30_I2C_ADDR
        hex "SHT30 I2C Address"
        default 0x44
        depends on HAS_ENVIII
        help
            I2C address of the SHT30 temperature/humidity sensor.

    config ENVIII_QMP6988_I2C_ADDR
        hex "QMP6988 I2C Address"
        default 0x70
        depends on HAS_ENVIII
        help
            I2C address of the QMP6988 pressure sensor.

    config ENVIII_I2C_PORT
        int "ENV-III I2C Port"
        range 0 1
        default 0
        depends on HAS_ENVIII
        help
            Select the I2C controller port used for ENV-III sensors.

    endmenu

    menu "Accelerometer Configuration"

    config HAS_ACCELEROMETER
        bool "Enable Accelerometer App"
        default n
        help
            Enable Accelerometer application using ADXL345.

    config ACCEL_USE_BMI270
        bool "Use BMI270 accelerometer"
        default n
        depends on HAS_ACCELEROMETER
        help
            Use the official BMI270 firmware upload and register map instead
            of the default ADXL345 driver.

    config ACCEL_I2C_ADDR
        hex "ADXL345 I2C Address"
        default 0x53
        depends on HAS_ACCELEROMETER
        help
            I2C address of the ADXL345 accelerometer (0x53 default, 0x1D if SDO high).

    config ACCEL_I2C_PORT
        int "Accelerometer I2C Port"
        range 0 1
        default 0
        depends on HAS_ACCELEROMETER
        help
            Select the I2C controller port used for the accelerometer.

    endmenu

    menu "Native SD Apps"

    config ENABLE_NATIVE_SD_APPS
        bool "Enable native apps loaded from SD"
        default n if IS_ATOMS3R
        default y
        depends on SPIRAM
        depends on IDF_TARGET_ESP32 || IDF_TARGET_ESP32S2 || IDF_TARGET_ESP32S3 || IDF_TARGET_ESP32C6 || IDF_TARGET_ESP32C61 || IDF_TARGET_ESP32P4 || IDF_TARGET_ESP32C5
        select ELF_LOADER
        select ELF_DYNAMIC_LOAD_SHARED_OBJECT
        help
            Enable Flipper-style native apps loaded from /mnt/ghostesp/apps.
            Apps are trusted native code loaded with Espressif's ELF loader.

    config NATIVE_SD_APPS_REQUIRE_TARGET_MATCH
        bool "Require native app target match"
        default y
        depends on ENABLE_NATIVE_SD_APPS
        help
            Reject apps built for a different ESP chip target.

    config NATIVE_SD_APP_MAX_COUNT
        int "Maximum number of SD apps to scan"
        default 32
        range 1 32
        depends on ENABLE_NATIVE_SD_APPS
        help
            Maximum number of native SD apps that can be registered.
            Lower values save PSRAM. The default is 32.

    endmenu

    menu "GhostScript"

    config ENABLE_GHOSTSCRIPT
        bool "Enable GhostScript Lua scripting"
        default y
        help
            Enable the low-memory Lua scripting runtime loaded from
            /mnt/ghostesp/scripts. It is available through the browser on
            screen builds and through the script CLI on headless builds.

    endmenu

    menu "SPI and MMC Configuration"
    
    config USING_SPI
        bool "Enable SPI"
        default n
        help
            Enable SPI communication.
    
    config USING_MMC
        bool "Enable MMC"
        default n
        help
            Enable MMC support.

    config USING_MMC_1_BIT
        bool "Enable MMC (1-bit mode)"
        default n
        help
            Enable MMC support (1-bit mode).
    
    config SD_SPI_CS_PIN
        int "SD Card SPI CS Pin"
        default 4
        depends on USING_SPI
        help
            Define the Chip Select (CS) pin for SD Card SPI.
    
    config SD_SPI_CLK_PIN
        int "SD Card SPI CLK Pin"
        default 18
        depends on USING_SPI
        help
            Define the Clock (CLK) pin for SD Card SPI.
    
    config SD_SPI_MISO_PIN
        int "SD Card SPI MISO Pin"
        default 19
        depends on USING_SPI
        help
            Define the MISO pin for SD Card SPI.
    
    config SD_SPI_MOSI_PIN
        int "SD Card SPI MOSI Pin"
        default 23
        depends on USING_SPI
        help
            Define the MOSI pin for SD Card SPI.

    config SHARED_TFT_SD_SPI
        bool "Shared TFT/SD SPI bus"
        default n
        depends on USING_SPI && WITH_SCREEN
        help
            Enable extra TFT/SD SPI bus coordination for boards that share
            MOSI/MISO/CLK between display and SD card.

    config SD_MMC_D0 
        int "SD Card D0 Pin"
        default 13
        depends on USING_MMC_1_BIT
        help
            Define the MOSI pin for SD Card SPI.
            
    config SD_MMC_CLK
        int "SD Card CLK Pin"
        default 12
        depends on USING_MMC_1_BIT
        help
            Define the MISO pin for SD Card SPI.
            
    config SD_MMC_CMD 
        int "SD Card CMD Pin"
        default 11
        depends on USING_MMC_1_BIT
        help
            Define the MOSI pin for SD Card SPI.
    
    endmenu
    
    menu "Audio & DAC Configuration"

        config HAS_ES7210_MIC
            bool "Enable ES7210 microphone codec"
            default n
            depends on HAS_MIC
            help
                Initialize the M5Stack CoreS3 ES7210 microphone codec.

        config ES7210_I2C_ADDR
            hex "ES7210 I2C Address"
            default 0x40
            depends on HAS_ES7210_MIC

        config HAS_AW88298_SPEAKER
            bool "Enable AW88298 speaker codec"
            default n
            help
                Initialize the M5Stack CoreS3 AW88298 speaker codec.

        config AW88298_I2C_ADDR
            hex "AW88298 I2C Address"
            default 0x36
            depends on HAS_AW88298_SPEAKER

        config CORES3_AUDIO_I2C_PORT
            int "CoreS3 audio I2C port"
            range 0 1
            default 0
            depends on HAS_ES7210_MIC || HAS_AW88298_SPEAKER

        menu "Audio Player (C5 Display)"
            config HAS_AUDIO_PLAYER
                bool "Enable Audio Player App"
                default n
                depends on WITH_SCREEN && (USING_SPI || USING_MMC_1_BIT) && (HAS_TLV320DAC_I2C || HAS_AW88298_SPEAKER || HAS_CROWPANEL_NS4168)
                help
                    Enable MP3 audio player UI and SD card playback. Streams to a
                    GhostLink peer when one is connected, or plays through the
                    on-board speaker when the device has its own audio output.

            config AUDIO_FILES_PATH
                string "Audio Files Directory"
                default "/mnt/ghostesp/audio"
                depends on HAS_AUDIO_PLAYER
                help
                    Directory on SD card to scan for MP3 files.
        endmenu

        menu "TLV320DAC3100 DAC (I2C Control - C5)"
            config HAS_TLV320DAC_I2C
                bool "Enable TLV320DAC3100 I2C Control"
                default n
                depends on USE_IO_EXPANDER
                help
                    Enable I2C control of TLV320DAC3100 DAC on ESP32-C5.

            config TLV320DAC_I2C_ADDR
                hex "TLV320DAC3100 I2C Address"
                default 0x18
                depends on HAS_TLV320DAC_I2C
                help
                    I2C address of the TLV320DAC3100 (default 0x18).

            config TLV320DAC_I2C_SDA_PIN
                int "TLV320DAC SDA Pin"
                default 6
                depends on HAS_TLV320DAC_I2C
                help
                    GPIO pin for TLV320DAC3100 I2C SDA.

            config TLV320DAC_I2C_SCL_PIN
                int "TLV320DAC SCL Pin"
                default 7
                depends on HAS_TLV320DAC_I2C
                help
                    GPIO pin for TLV320DAC3100 I2C SCL.

            config TLV320DAC_RESET_IO_EXPANDER_PIN
                int "DAC Reset IO Expander Pin (P13 = bit 3 on port1)"
                default 3
                depends on HAS_TLV320DAC_I2C
                help
                    Bit index on IO expander port 1 for DAC RESET line.
                    P13 on the TCA9539RTWR corresponds to bit 3 of port 1.
        endmenu

        menu "CrowPanel P4 NS4168 Audio"
            config HAS_CROWPANEL_NS4168
                bool "Enable CrowPanel P4 NS4168 I2S Audio (BCLK22/WCLK21/DIN23)"
                default n
                depends on IDF_TARGET_ESP32P4 && CROWPANEL_ADVANCED_P4
                help
                    Enable I2S TX to the CrowPanel Advanced P4 dual NS4168 amplifiers.
                    Uses I2S_NUM_1 master: BCLK=GPIO22, WCLK=GPIO21, DIN=GPIO23,
                    amplifier enable (active-low) via STC8 I2C on the 5-inch RGB
                    board or GPIO30 on MIPI boards. Audio sourced from SD.

        endmenu

        menu "TLV320DAC3100 DAC (I2S Audio - S3)"
            config HAS_TLV320DAC_I2S
                bool "Enable TLV320DAC3100 I2S Audio Output"
                default n
                depends on IDF_TARGET_ESP32S3
                help
                    Enable I2S master output to TLV320DAC3100 on ESP32-S3.

            config TLV320DAC_I2S_DIN_PIN
                int "I2S DIN Pin (Data to DAC)"
                default 1
                depends on HAS_TLV320DAC_I2S
                help
                    I2S data output pin connected to TLV320DAC3100 DIN.

            config TLV320DAC_I2S_WCLK_PIN
                int "I2S WCLK/LRCLK Pin"
                default 45
                depends on HAS_TLV320DAC_I2S
                help
                    I2S word clock (LRCLK) pin.

            config TLV320DAC_I2S_BCLK_PIN
                int "I2S BCLK Pin"
                default 46
                depends on HAS_TLV320DAC_I2S
                help
                    I2S bit clock pin.

            config TLV320DAC_SAMPLE_RATE
                int "Default I2S Sample Rate"
                default 44100
                depends on HAS_TLV320DAC_I2S
                help
                    Default I2S sample rate in Hz. The MP3 decoder will auto-detect
                    the actual rate from the MP3 file and configure the DAC accordingly.
        endmenu

    endmenu

endmenu
