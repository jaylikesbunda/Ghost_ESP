{
  "id": "doom_port",
  "name": "Doom Port",
  "version": "0.1.7",
  "author": "GhostESP",
  "description": "DoomGeneric with a large-screen P4 layout and touch controls.",
  "category": "Games",
  "entry": "doom_port.so",
  "target": "esp32p4",
  "api_version": 1,
  "manifest_version": 1,
  "package_version": 1,
  "data_version": 1,
  "storage_scope": "app",
  "icon": "icon.rgb565",
  "icon_source": "doom.png",
  "icon_format": "true_color_alpha",
  "icon_width": 50,
  "icon_height": 50,
  "accent_color": "#B22222",
  "permissions": ["ui", "input", "time", "storage"],
  "requires_features": ["touchscreen"],
  "assets": ["assets"],
  "direct_read_assets": true,
  "memory_limit": 0,
  "stack_size": 8192,
  "tick_interval_ms": 28,
  "requires_psram": true
}
